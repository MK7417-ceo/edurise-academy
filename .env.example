# ── Backend ──────────────────────────────────────────────────────────────
# SQLite file location (created automatically on first run)
DATABASE_PATH=./data/edurise.db
# Knowledge base location (edit data/knowledge-base.json to change site content)
KNOWLEDGE_BASE_PATH=./data/knowledge-base.json
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Admin dashboard (MOCK auth for local demo — change before sharing) ──────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=edurise123
ADMIN_TOKEN_TTL_SECONDS=43200

# ── AI chatbot (OpenAI-compatible) ───────────────────────────────────────────
# Leave OPENAI_API_KEY empty to run the chatbot in built-in DEMO (mock) mode —
# it answers from data/knowledge-base.json with no API calls and no cost.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# ── Frontend ─────────────────────────────────────────────────────────────────
# Public: where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public: canonical site URL (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: where Next.js server components reach the API (docker: http://backend:8000)
BACKEND_URL=http://localhost:8000
